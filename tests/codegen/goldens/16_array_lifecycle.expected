12 MOV RBX IMM8 [3
12 CALL RBX                  ; CALL [dbprocore.dll ,?UnDimDD@@YA_K_K@Z ; ASSIGN RAX TO X 
12 POP RBX                   ; POP RBX FROM STACK 
12 MOV MEM IMM4 @$_SLN_, 12
12 MOV EAX MEM @$_ERR_
12 CMP EAX 0
12 JNE $labelend             ; CALL Normal Runtime Error Hook 
   0 
   13 LINE : undim cube()
   0 
13 MOV RAX MEM8 @&cube

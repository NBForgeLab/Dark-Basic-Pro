REM EXPECT: COMPILE_SUCCESS
REM EXPECT: RUNTIME_OUTPUT "FuncResult: 15"
REM EXPECT: EXIT_CODE 0
REM EXPECT: TIMEOUT_SECONDS 5

val1 = 5
val2 = 10
res = my_addition_func(val1, val2)

if file exist("output.txt") then delete file "output.txt"
open to write 1, "output.txt"
write string 1, "FuncResult: " + str$(res)
close file 1
end

function my_addition_func(x, y)
    local result
    result = x + y
endfunction result

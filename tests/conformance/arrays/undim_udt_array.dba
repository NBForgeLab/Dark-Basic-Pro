REM EXPECT: COMPILE_SUCCESS
REM EXPECT: RUNTIME_OUTPUT "UDT_UNDIM_OK: 99"
REM EXPECT: EXIT_CODE 0
REM EXPECT: TIMEOUT_SECONDS 5

type Point2D
    x as integer
    y as integer
endtype

dim points(5) as Point2D
points(2).x = 10
points(2).y = 20
undim points()

dim points(10) as Point2D
points(8).x = 99
points(8).y = 88
finalVal = points(8).x
msg$ = "UDT_UNDIM_OK: " + str$(finalVal)

if file exist("output.txt") = 1 then delete file "output.txt"
open to write 1, "output.txt"
write string 1, msg$
close file 1
end

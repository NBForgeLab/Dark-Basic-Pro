REM EXPECT: COMPILE_SUCCESS
REM EXPECT: RUNTIME_OUTPUT "STRING_UNDIM_OK: WORLD"
REM EXPECT: EXIT_CODE 0
REM EXPECT: TIMEOUT_SECONDS 5

dim strArr$(5)
strArr$(2) = "HELLO"
undim strArr$()

dim strArr$(15)
strArr$(10) = "WORLD"
s$ = strArr$(10)
msg$ = "STRING_UNDIM_OK: " + s$

if file exist("output.txt") = 1 then delete file "output.txt"
open to write 1, "output.txt"
write string 1, msg$
close file 1
end

REM EXPECT: COMPILE_SUCCESS
REM EXPECT: RUNTIME_OUTPUT "PLAYER: Hero / HP: 100"
REM EXPECT: EXIT_CODE 0
REM EXPECT: TIMEOUT_SECONDS 5

TYPE PlayerInfo
    name AS STRING
    health AS INTEGER
ENDTYPE

DIM party(5) AS PlayerInfo
party(1).name = "Hero"
party(1).health = 100

heroName$ = party(1).name
heroHp = party(1).health
msg$ = "PLAYER: " + heroName$ + " / HP: " + str$(heroHp)

if file exist("output.txt") = 1 then delete file "output.txt"
open to write 1, "output.txt"
write string 1, msg$
close file 1
end

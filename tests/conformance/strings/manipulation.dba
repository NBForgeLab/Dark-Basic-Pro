REM EXPECT: COMPILE_SUCCESS
REM EXPECT: RUNTIME_OUTPUT "Left: Hello"
REM EXPECT: RUNTIME_OUTPUT "Right: World"
REM EXPECT: RUNTIME_OUTPUT "Length: 11"
REM EXPECT: EXIT_CODE 0
REM EXPECT: TIMEOUT_SECONDS 5

original$ = "Hello World"
sub1$ = left$(original$, 5)
sub2$ = right$(original$, 5)
length = len(original$)

if file exist("output.txt") then delete file "output.txt"
open to write 1, "output.txt"
write string 1, "Left: " + sub1$
write string 1, "Right: " + sub2$
write string 1, "Length: " + str$(length)
close file 1
end

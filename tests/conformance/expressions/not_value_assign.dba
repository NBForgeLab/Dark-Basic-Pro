REM EXPECT: COMPILE_SUCCESS
REM EXPECT: RUNTIME_OUTPUT "NVAL: 1"
REM EXPECT: EXIT_CODE 0
REM EXPECT: TIMEOUT_SECONDS 5

a = 10
b = 20
r = NOT (a = b)
REM normalized boolean must read back as nonzero truthy
t = 0
if r then t = 1

if file exist("output.txt") = 1 then delete file "output.txt"
open to write 1, "output.txt"
write string 1, "NVAL: " + str$(t)
close file 1
end

REM EXPECT: COMPILE_SUCCESS
REM EXPECT: RUNTIME_OUTPUT "PlayerX: 10"
REM EXPECT: RUNTIME_OUTPUT "PlayerY: 20"
REM EXPECT: RUNTIME_OUTPUT "PlayerName: Hero"
REM EXPECT: EXIT_CODE 0
REM EXPECT: TIMEOUT_SECONDS 5

type PlayerType
    x as integer
    y as integer
    name as string
endtype

p as PlayerType
p.x = 10
p.y = 20
p.name = "Hero"

if file exist("output.txt") then delete file "output.txt"
open to write 1, "output.txt"
write string 1, "PlayerX: " + str$(p.x)
write string 1, "PlayerY: " + str$(p.y)
write string 1, "PlayerName: " + p.name
close file 1
end

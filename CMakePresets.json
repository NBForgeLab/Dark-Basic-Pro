{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-x64-debug",
      "inherits": "windows-x64-base",
      "displayName": "Windows x64 Debug",
      "description": "Official 64-bit native debug build with compiler and CTest coverage"
    },
    {
      "name": "windows-x64-release",
      "inherits": "windows-x64-base",
      "displayName": "Windows x64 Release",
      "description": "Official 64-bit native optimized release build with compiler and CTest coverage"
    },
    {
      "name": "windows-x64-asan",
      "inherits": "windows-x64-base",
      "displayName": "windows x64 asan",
      "description": "64-bit native build instrumented with MSVC AddressSanitizer",
      "cacheVariables": {
        "DBP_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "windows-x64-ubsan",
      "inherits": "windows-x64-base",
      "displayName": "windows x64 ubsan",
      "description": "64-bit native build instrumented with MSVC UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "DBP_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "windows-x64-coverage",
      "inherits": "windows-x64-base",
      "displayName": "windows x64 coverage",
      "description": "64-bit native build instrumented with code coverage",
      "cacheVariables": {
        "DBP_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "windows-x64-clang-tidy",
      "inherits": "windows-x64-base",
      "displayName": "windows x64 clang tidy",
      "description": "64-bit native static analysis build with clang-tidy integration",
      "cacheVariables": {
        "DBP_ENABLE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests"
      ]
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests"
      ]
    },
    {
      "name": "windows-x64-asan",
      "configurePreset": "windows-x64-asan",
      "configuration": "Debug",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests"
      ]
    },
    {
      "name": "windows-x64-coverage",
      "configurePreset": "windows-x64-coverage",
      "configuration": "Debug",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests"
      ]
    },
    {
      "name": "windows-x64-clang-tidy",
      "configurePreset": "windows-x64-clang-tidy",
      "configuration": "Debug",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests"
      ]
    },
    {
      "name": "windows-x64-ubsan",
      "configurePreset": "windows-x64-ubsan",
      "configuration": "Debug",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests",
        "dbp_ubsan_probe_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-asan",
      "configurePreset": "windows-x64-asan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:detect_leaks=0"
      }
    },
    {
      "name": "windows-x64-ubsan",
      "configurePreset": "windows-x64-ubsan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:abort_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "windows-x64-coverage",
      "configurePreset": "windows-x64-coverage",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x64-clang-tidy",
      "configurePreset": "windows-x64-clang-tidy",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}

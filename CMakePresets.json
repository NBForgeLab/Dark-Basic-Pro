{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x86-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-x86-debug",
      "inherits": "windows-x86-base",
      "displayName": "Windows x86 Debug",
      "description": "Compatibility baseline with compiler and CTest coverage"
    },
    {
      "name": "windows-x86-release",
      "inherits": "windows-x86-base",
      "displayName": "Windows x86 Release",
      "description": "Optimized release build with compiler, runtime, and CTest coverage"
    },
    {
      "name": "windows-x86-asan",
      "inherits": "windows-x86-base",
      "displayName": "Windows x86 AddressSanitizer",
      "description": "Compatibility baseline instrumented with MSVC AddressSanitizer",
      "cacheVariables": {
        "DBP_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "windows-x86-ubsan",
      "inherits": "windows-x86-base",
      "displayName": "Windows x86 UndefinedBehaviorSanitizer",
      "description": "Compatibility baseline instrumented with MSVC UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "DBP_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "windows-x86-coverage",
      "inherits": "windows-x86-base",
      "displayName": "Windows x86 Code Coverage",
      "description": "Compatibility baseline instrumented with code coverage",
      "cacheVariables": {
        "DBP_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "windows-x86-clang-tidy",
      "inherits": "windows-x86-base",
      "displayName": "Windows x86 clang-tidy",
      "description": "Static analysis build with clang-tidy integration",
      "cacheVariables": {
        "DBP_ENABLE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86-debug",
      "configuration": "Debug",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests"
      ]
    },
    {
      "name": "windows-x86-asan",
      "configurePreset": "windows-x86-asan",
      "configuration": "Debug",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests"
      ]
    },
    {
      "name": "windows-x86-ubsan",
      "configurePreset": "windows-x86-ubsan",
      "configuration": "Debug",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests",
        "dbp_ubsan_probe_tests"
      ]
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86-release",
      "configuration": "Release",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests"
      ]
    },
    {
      "name": "windows-x86-coverage",
      "configurePreset": "windows-x86-coverage",
      "configuration": "Debug",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests"
      ]
    },
    {
      "name": "windows-x86-clang-tidy",
      "configurePreset": "windows-x86-clang-tidy",
      "configuration": "Debug",
      "jobs": 8,
      "targets": [
        "DBPCompiler",
        "DarkEXE",
        "dbp_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x86-asan",
      "configurePreset": "windows-x86-asan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:detect_leaks=0"
      }
    },
    {
      "name": "windows-x86-ubsan",
      "configurePreset": "windows-x86-ubsan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:abort_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x86-coverage",
      "configurePreset": "windows-x86-coverage",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-x86-clang-tidy",
      "configurePreset": "windows-x86-clang-tidy",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
